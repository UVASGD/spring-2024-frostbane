[sub_resource type="GDScript" id="GDScript_s1tva"]
script/source = "extends TextureRect

@export var maxOpacityPercentage :float

func _on_health_compoent_lost_hp(percent):
	self.modulate.a = (1 - percent) * maxOpacityPercentage
	print((1 - percent) * 100)
"

